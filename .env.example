# PostgreSQL (names match the Vercel Postgres / Neon integration).
# POSTGRES_PRISMA_URL is the pooled URL used at runtime; POSTGRES_URL_NON_POOLING is used by migrations.
# Locally both can point at the same database.
POSTGRES_PRISMA_URL=postgresql://USER:PASSWORD@localhost:5432/pit_lane_hub?schema=public
POSTGRES_URL_NON_POOLING=postgresql://USER:PASSWORD@localhost:5432/pit_lane_hub?schema=public

# Auth.js (NextAuth v5). Generate a secret with: npx auth secret
AUTH_SECRET=replace-with-a-long-random-secret
# Public origin used in verification emails and Polar return URLs. Set this in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Only needed when self-hosting `next start` outside Vercel (Vercel trusts its host automatically).
# AUTH_TRUST_HOST=true

# Resend: magic links, verification emails. EMAIL_FROM must use a domain verified in Resend.
AUTH_RESEND_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="Pit Lane Hub <noreply@example.com>"

# Polar (Pit Lane Pro). Checkout returns 503 until POLAR_ACCESS_TOKEN and POLAR_PRODUCT_ID are set.
# Webhook endpoint: <site>/api/polar/webhook, subscribed to subscription.* events.
POLAR_ACCESS_TOKEN=polar_oat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POLAR_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POLAR_PRODUCT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# "production" or "sandbox" (sandbox tokens and products are separate)
POLAR_SERVER=production

# Optional shared rate limiting (memory fallback is used when both are absent)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional authenticated OpenF1 access
OPENF1_USERNAME=
OPENF1_PASSWORD=
